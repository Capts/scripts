                    print(dst_layout)

                    # Diagnostic verification check
                    if "disk5s3" not in dst_layout and "3:" not in dst_layout:
                        print(f"\n{RED}========================================================================{RESET}")
                        print(f"{RED}[!] DIAGNOSTIC ALERT: Partition 3 (LVM) IS MISSING FROM TARGET DISK.{RESET}")
                        print(f"{RED}    Reason: Destination capacity was exhausted before reaching Partition 3.{RESET}")
                        print(f"{YELLOW}    Result: Booting this drive will trigger '/dev/mapper/pve-root does not exist'.{RESET}")
                        print(f"{CYAN}    Solution: Re-clone using Clonezilla Live USB (-icds flag) to shrink LVM.{RESET}")
                        print(f"{RED}========================================================================{RESET}")
                else:
                    print(f"\n{RED}[!] Cloning encountered an error or was interrupted.{RESET}")
            else:
                print("Cloning operation cancelled.")

        get_tty_input("\nPress [Enter] to return to the main menu...")
