                subprocess.run(f"diskutil unmountDisk /dev/{dst_clean}", shell=True)

                if is_downsizing:
                    count_blocks = dst_bytes // (1024 * 1024)
                    clone_cmd = f"sudo dd if={src_rdisk} of={dst_rdisk} bs=1m count={count_blocks} status=progress"
                else:
                    clone_cmd = f"sudo dd if={src_rdisk} of={dst_rdisk} bs=1m status=progress"

                print(f"\n{CYAN}[2/4] Executing block transfer...{RESET}")
