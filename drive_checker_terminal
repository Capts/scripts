    print("  [8] Automated Smart Block Clone + Temp-Env GPT Repair")
    print("  [9] Exit")
    print(f"{BLUE}=================================================={RESET}")
    
    choice = get_tty_input("Select an option (1-9): ")
    
    if choice == '9':
        print("Exiting tool. Goodbye!")
        break
        
    if choice in ['1', '2', '3', '4', '5', '6', '7', '8']:
        show_disk_list()
        print(f"\n{YELLOW}--------------------------------------------------{RESET}")
        
        target = None
        source = None
        dest = None

        if choice == '7':
            target = get_valid_input("Enter parent disk identifier to unify (e.g., disk4): ")
        elif choice == '8':
            print(f"{YELLOW}Tip: Use full parent disk IDs (e.g., disk2 and disk3) for whole-drive cloning.{RESET}")
            source = get_valid_input("Enter SOURCE disk (e.g., disk2): ")
            if source:
                dest = get_valid_input("Enter DESTINATION disk (WARNING: WILL BE ERASED) (e.g., disk3): ")
            target = source
        else:
            target = get_valid_input("Enter target partition identifier (e.g., disk4s1): ")

        if not target or (choice == '8' and not dest):
            continue

        # --- OPTION 8: AUTOMATED SMART BLOCK CLONE + TEMP-ENV GPT REPAIR ---
        if choice == '8':
            src_clean = source.replace('/dev/', '').replace('rdisk', 'disk')
            dst_clean = dest.replace('/dev/', '').replace('rdisk', 'disk')
            
            src_rdisk = f"/dev/r{src_clean}"
            dst_rdisk = f"/dev/r{dst_clean}"

            src_bytes = get_disk_size_bytes(src_clean)
            dst_bytes = get_disk_size_bytes(dst_clean)

            print(f"\n{RED}[DANGER ZONE] AUTOMATED SMART BLOCK-LEVEL CLONE{RESET}")
            print(f"  Source Device      : {GREEN}{src_rdisk}{RESET} ({src_bytes / (1024**3):.2f} GB)")
            print(f"  Destination Device : {RED}{dst_rdisk}{RESET} ({dst_bytes / (1024**3):.2f} GB)")

            is_downsizing = dst_bytes < src_bytes

            if is_downsizing:
                print(f"\n{YELLOW}[!] ATTENTION: Destination drive is SMALLER than Source drive.{RESET}")
