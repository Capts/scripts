python3 - << 'EOF'
import os
import subprocess
import time
import sys
from datetime import datetime

# ANSI Color Codes
GREEN = '\033[92m'
RED = '\033[91m'
YELLOW = '\033[93m'
BLUE = '\033[94m'
CYAN = '\033[96m'
RESET = '\033[0m'
BOLD = '\033[1m'

def run_cmd(cmd):
    result = subprocess.run(cmd, shell=True, text=True, capture_output=True)
    return result.stdout.strip()

def get_tty_input(prompt):
    sys.stdout.write(prompt)
    sys.stdout.flush()
    with open('/dev/tty', 'r') as tty:
        return tty.readline().strip()

def get_valid_input(prompt, max_retries=3):
    """Loops until user enters text. Returns None if max empty tries are reached."""
    attempts = 0
    while attempts < max_retries:
        val = get_tty_input(prompt)
        if val:
            return val
        attempts += 1
        remaining = max_retries - attempts
        if remaining > 0:
            print(f"{RED}[!] Input cannot be blank. {remaining} empty attempt(s) left before returning to menu.{RESET}")
        else:
            print(f"\n{RED}[!] Too many blank inputs. Returning to main menu...{RESET}")
            return None
    return None

def show_disk_list():
    print(f"\n{CYAN}[Available Disks & Partitions]{RESET}")
    subprocess.run(["diskutil", "list"])

while True:
    print(f"\n{BLUE}=================================================={RESET}")
    print(f"{BLUE}   macOS Ultimate Drive Diagnostic & Repair Pro   {RESET}")
    print(f"{BLUE}=================================================={RESET}")
    print("  [1] Full Diagnostic Suite (Health + Repair + Speed Test)")
    print("  [2] Quick Speed Benchmark Only (1GB Read/Write Test)")
    print("  [3] File System Repair Tool (Fix Exit Code 8, Superblock)")
    print("  [4] Emergency Read-Only Mount (For pulling files off bad drives)")
    print("  [5] Smart Hardware Attribute Dump (View deep hardware stats)")
    print("  [6] Erase and Reformat Partition (Wipe specific volume)")
    print("  [7] Reformat & Unify Whole Disk (Erase parent disk into 1 volume)")
    print("  [8] Sector-by-Sector Clone / Backup (Copy source to destination)")
    print("  [9] Exit")
    print(f"{BLUE}=================================================={RESET}")
    
    choice = get_tty_input("Select an option (1-9): ")
    
    if choice == '9':
        print("Exiting tool. Goodbye!")
        break
        
    if choice in ['1', '2', '3', '4', '5', '6', '7', '8']:
        show_disk_list()
        print(f"\n{YELLOW}--------------------------------------------------{RESET}")
        
        target = None
        source = None
        dest = None

        if choice == '7':
            target = get_valid_input("Enter parent disk identifier to unify (e.g., disk4): ")
        elif choice == '8':
            source = get_valid_input("Enter SOURCE disk/partition to clone (e.g., disk2s1): ")
            if source:
                dest = get_valid_input("Enter DESTINATION disk/partition (WARNING: WILL BE ERASED) (e.g., disk3s1): ")
            target = source # placeholder for logging
        else:
            target = get_valid_input("Enter target partition identifier (e.g., disk4s1): ")

        # If any required input timed out / hit 3 blank tries, abort and loop back to menu
        if not target or (choice == '8' and not dest):
            continue

        # --- OPTION 1: FULL DIAGNOSTIC SUITE ---
        if choice == '1':
            print(f"\n{CYAN}[1/3] Checking Drive Info & Health for {target}...{RESET}")
            info_output = run_cmd(f"diskutil info {target}")
            print(info_output)

            is_whole_disk = "Whole: Yes" in info_output or not "s" in target

            if is_whole_disk:
                print(f"\n{YELLOW}[!] Note: '{target}' is a whole physical disk container, not a mountable partition slice.{RESET}")
                print(f"{YELLOW}Skipping volume file-system checks (use option [7] to unify/format).{RESET}")
            else:
                print(f"\n{CYAN}[2/3] Verifying File System for {target}...{RESET}")
                verify_output = run_cmd(f"diskutil verifyVolume {target}")
                print(verify_output)

                if "appears to be OK" not in verify_output:
                    print(f"\n{RED}[!] Corruption detected. Running automated repair sequence...{RESET}")
                    subprocess.run(["diskutil", "repairVolume", target])

            mount_point = None
            for line in info_output.split('\n'):
                if "Mount Point" in line:
                    parts = line.split(":", 1)
                    if len(parts) > 1:
                        mount_point = parts[1].strip()

            if (not mount_point or mount_point == "Not Mounted") and not is_whole_disk:
                print(f"{YELLOW}[!] Target unmounted. Attempting mount...{RESET}")
                subprocess.run(["diskutil", "mount", target])
                info_output = run_cmd(f"diskutil info {target}")
                for line in info_output.split('\n'):
                    if "Mount Point" in line:
                        parts = line.split(":", 1)
                        if len(parts) > 1:
                            mount_point = parts[1].strip()

            if mount_point and mount_point != "Not Mounted":
                print(f"\n{CYAN}[3/3] Running Blackmagic-Style Speed Test on [{mount_point}]...{RESET}")
                test_file = os.path.join(mount_point, "python_speed_test.tmp")
                block_size = 1024 * 1024
                chunk = b'\0' * block_size

                start_time = time.perf_counter()
                with open(test_file, "wb") as f:
                    for _ in range(1024):
                        f.write(chunk)
                    f.flush()
                    os.fsync(f.fileno())
                write_mb = 1024 / (time.perf_counter() - start_time)
                print(f"--> Write Speed: {GREEN}{write_mb:.2f} MB/s{RESET}")

                start_time = time.perf_counter()
                with open(test_file, "rb") as f:
                    while f.read(block_size):
                        pass
                read_mb = 1024 / (time.perf_counter() - start_time)
                print(f"--> Read Speed:  {GREEN}{read_mb:.2f} MB/s{RESET}")
                
                if os.path.exists(test_file):
                    os.remove(test_file)
                    
                save_report = get_tty_input("\nWould you like to save this diagnostic report to your Desktop? (y/n): ")
                if save_report.lower() == 'y':
                    desktop_path = os.path.expanduser("~/Desktop")
                    report_file = os.path.join(desktop_path, f"Drive_Report_{target}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt")
                    with open(report_file, "w") as rep:
                        rep.write(f"=== macOS Drive Diagnostic Report ===\nTarget: {target}\nDate: {datetime.now()}\n\n{info_output}\n\nWrite Speed: {write_mb:.2f} MB/s\nRead Speed: {read_mb:.2f} MB/s")
                    print(f"{GREEN}Report saved successfully to: {report_file}{RESET}")
            else:
                print(f"{RED}[!] Cannot run speed test because target has no mounted file system volume.{RESET}")

        # --- OPTION 2: QUICK SPEED BENCHMARK ---
        elif choice == '2':
            info_output = run_cmd(f"diskutil info {target}")
            mount_point = None
            for line in info_output.split('\n'):
                if "Mount Point" in line:
                    parts = line.split(":", 1)
                    if len(parts) > 1:
                        mount_point = parts[1].strip()
            
            if not mount_point or mount_point == "Not Mounted":
                print(f"{YELLOW}Drive unmounted. Attempting auto-mount...{RESET}")
                subprocess.run(["diskutil", "mount", target])
                info_output = run_cmd(f"diskutil info {target}")
                for line in info_output.split('\n'):
                    if "Mount Point" in line:
                        parts = line.split(":", 1)
                        if len(parts) > 1:
                            mount_point = parts[1].strip()

            if mount_point and mount_point != "Not Mounted":
                print(f"\n{CYAN}Running Quick Benchmark on {mount_point}...{RESET}")
                test_file = os.path.join(mount_point, "quick_bench.tmp")
                chunk = b'\0' * (1024 * 1024)
                
                start = time.perf_counter()
                with open(test_file, "wb") as f:
                    for _ in range(512):
                        f.write(chunk)
                    f.flush()
                    os.fsync(f.fileno())
                w_speed = 512 / (time.perf_counter() - start)
                
                start = time.perf_counter()
                with open(test_file, "rb") as f:
                    while f.read(1024 * 1024):
                        pass
                r_speed = 512 / (time.perf_counter() - start)
                
                if os.path.exists(test_file):
                    os.remove(test_file)
                    
                print(f"--> Quick Write: {GREEN}{w_speed:.2f} MB/s{RESET}")
                print(f"--> Quick Read:  {GREEN}{r_speed:.2f} MB/s{RESET}")
            else:
                print(f"{RED}Error: Drive could not be mounted for benchmarking.{RESET}")

        # --- OPTION 3: ADVANCED FILE SYSTEM REPAIR ---
        elif choice == '3':
            print(f"\n{CYAN}Running deep file system repair on {target}...{RESET}")
            subprocess.run(["diskutil", "unmount", "force", target])
            info_output = run_cmd(f"diskutil info {target}")
            fs_type = "hfs" if "HFS" in info_output else "apfs"
            
            print(f"Executing low-level fsck_{fs_type}...")
            subprocess.run(f"sudo fsck_{fs_type} -y /dev/{target}", shell=True)
            subprocess.run(["diskutil", "repairVolume", target])
            subprocess.run(["diskutil", "mount", target])
            print(f"{GREEN}Repair sequence completed.{RESET}")

        # --- OPTION 4: EMERGENCY READ-ONLY MOUNT ---
        elif choice == '4':
            print(f"\n{CYAN}Forcing Read-Only mount for data recovery...{RESET}")
            res = run_cmd(f"diskutil mount readOnly {target}")
            print(res)
            print(f"{GREEN}Check your Mac Desktop/Finder to copy your files immediately!{RESET}")

        # --- OPTION 5: SMART ATTRIBUTE DUMP ---
        elif choice == '5':
            print(f"\n{CYAN}Fetching hardware stats for {target}...{RESET}")
            res = run_cmd(f"diskutil info {target}")
            print(res)

        # --- OPTION 6: ERASE & REFORMAT PARTITION ---
        elif choice == '6':
            print(f"\n{RED}[WARNING] This will permanently erase partition {target}!{RESET}")
            confirm = get_tty_input("Type 'YES' to proceed with formatting: ")
            if confirm == 'YES':
                new_name = get_valid_input("Enter new drive name: ")
                if new_name:
                    print(f"Formatting {target} to APFS...")
                    subprocess.run(["diskutil", "eraseVolume", "APFS", new_name, target])
                    print(f"{GREEN}Formatting complete!{RESET}")
            else:
                print("Formatting aborted.")

        # --- OPTION 7: REFORMAT & UNIFY WHOLE DISK ---
        elif choice == '7':
            print(f"\n{RED}[WARNING] This will wipe ENTIRE physical disk '{target}' and merge it into 1 partition!{RESET}")
            confirm = get_tty_input("Type 'YES' to confirm wiping the entire disk: ")
            if confirm == 'YES':
                new_name = get_valid_input("Enter a name for the unified drive: ")
                if new_name:
                    print(f"\nSelect File System Format:")
                    print("  [1] APFS (Best for Mac-only use)")
                    print("  [2] ExFAT (Best if used between Mac and Windows)")
                    fmt_choice = get_tty_input("Enter choice (1-2, default is 1): ")
                    file_system = "ExFAT" if fmt_choice == '2' else "APFS"
                    
                    print(f"\n{CYAN}Wiping and reformatting {target} into a single {file_system} volume...{RESET}")
                    subprocess.run(["diskutil", "eraseDisk", file_system, new_name, target])
                    print(f"{GREEN}Unified formatting complete!{RESET}")
            else:
                print("Operation cancelled.")

        # --- OPTION 8: CLONE / BACKUP UTILITY ---
        elif choice == '8':
            print(f"\n{RED}[WARNING] Source: {source} -> Destination: {dest}{RESET}")
            print(f"{RED}All data on the destination drive will be permanently overwritten!{RESET}")
            confirm = get_tty_input("Type 'CLONE' to confirm the cloning process: ")
            if confirm == 'CLONE':
                print(f"\n{CYAN}Cloning partition data using Apple Software Restore (asr)...{RESET}")
                clone_cmd = f"sudo asr restore --source /dev/{source} --target /dev/{dest} --erase --noprompt"
                print(f"Executing: {clone_cmd}")
                subprocess.run(clone_cmd, shell=True)
                print(f"{GREEN}Cloning process finished.{RESET}")
            else:
                print("Cloning cancelled.")
                
        get_tty_input("\nPress [Enter] to return to the main menu...")
