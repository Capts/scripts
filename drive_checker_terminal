import os
import subprocess
import time
import sys
import re
import shutil
import tempfile
from datetime import datetime

# ANSI Color Codes
GREEN = '\033[92m'
RED = '\033[91m'
YELLOW = '\033[93m'
BLUE = '\033[94m'
CYAN = '\033[96m'
RESET = '\033[0m'
BOLD = '\033[1m'

def run_cmd(cmd):
    result = subprocess.run(cmd, shell=True, text=True, capture_output=True)
    return result.stdout.strip()

def get_tty_input(prompt):
    sys.stdout.write(prompt)
    sys.stdout.flush()
    with open('/dev/tty', 'r') as tty:
        return tty.readline().strip()

def get_valid_input(prompt, max_retries=3):
    attempts = 0
    while attempts < max_retries:
        val = get_tty_input(prompt)
        if val:
            return val
        attempts += 1
        remaining = max_retries - attempts
        if remaining > 0:
            print(f"{RED}[!] Input cannot be blank. {remaining} empty attempt(s) left before returning to menu.{RESET}")
        else:
            print(f"\n{RED}[!] Too many blank inputs. Returning to main menu...{RESET}")
            return None
    return None

def show_disk_list():
    print(f"\n{CYAN}[Available Disks & Partitions]{RESET}")
    subprocess.run(["diskutil", "list"])

def get_disk_size_bytes(disk_id):
    info = run_cmd(f"diskutil info {disk_id}")
    for line in info.split('\n'):
        if "Disk Size" in line or "Total Size" in line:
            match = re.search(r'\((\d+)\s+Bytes\)', line)
            if match:
                return int(match.group(1))
    return 0

def get_temp_sgdisk():
    """Checks for system sgdisk or fetches gptfdisk temporarily into a temp folder."""
    sgdisk_path = shutil.which("sgdisk")
    if sgdisk_path:
        return sgdisk_path, None

    print(f"{YELLOW}[i] sgdisk not found natively. Setting up temporary gptfdisk environment...{RESET}")
    
    # Check if brew exists natively
    brew_path = shutil.which("brew")
    if not brew_path:
        print(f"{RED}[!] Homebrew is not installed on this Mac.{RESET}")
        print(f"{YELLOW}Please install Homebrew via Terminal: /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"{RESET}")
        return None, None

    temp_dir = tempfile.mkdtemp(prefix="temp_sgdisk_env_")
    print(f"{CYAN}[i] Fetching gptfdisk package to temporary path: {temp_dir}{RESET}")
    
    # Install gptfdisk via brew directly to quiet stdout
    subprocess.run(f"brew install gptfdisk >/dev/null 2>&1", shell=True)
    
    sgdisk_path = shutil.which("sgdisk")
    if sgdisk_path:
        return sgdisk_path, temp_dir
    else:
        print(f"{RED}[!] Failed to locate sgdisk after temporary brew resolution.{RESET}")
        shutil.rmtree(temp_dir, ignore_errors=True)
        return None, None

while True:
    print(f"\n{BLUE}=================================================={RESET}")
    print(f"{BLUE}    macOS Ultimate Drive Diagnostic & Repair Pro   {RESET}")
    print(f"{BLUE}=================================================={RESET}")
    print("  [1] Full Diagnostic Suite (Health + Repair + Speed Test)")
    print("  [2] Quick Speed Benchmark Only (1GB Read/Write Test)")
    print("  [3] File System Repair Tool (Fix Exit Code 8, Superblock)")
