cat << 'EOF' > "$TEMP_PY"
import subprocess
import time
import sys
import os
import re
import json
import select
import tty
import termios
import warnings
import requests

warnings.filterwarnings("ignore")

# Escape Sequences
VT_DOUBLE_TOP = "\033#3"
VT_DOUBLE_BOT = "\033#4"
CLR_LINE = "\033[K"

class KaraokeApp:
    def __init__(self):
        self.headers = {"User-Agent": "macOS-Karaoke-CLI/14.0"}
        self.cache_dir = os.path.expanduser("~/.cache/terminal_karaoke")
        self.local_lyrics_dir = os.path.expanduser("~/Lyrics")
        self.config_file = os.path.expanduser("~/.config/terminal_karaoke.json")
        
        os.makedirs(self.cache_dir, exist_ok=True)
        os.makedirs(self.local_lyrics_dir, exist_ok=True)
        
        self.offset = self.load_config()
        self.current_track_id = None
        self.current_title = ""
        self.current_artist = ""
        self.lyrics = None
        self.last_active_index = -2
        self.start_wall_time = 0.0
        self.base_audio_time = 0.0
        self.was_paused = False
        
        self.last_media_check = 0.0
        self.cached_media = None

    def load_config(self):
        if os.path.exists(self.config_file):
            try:
                with open(self.config_file, "r") as f:
                    return json.load(f).get("offset", 0.0)
            except Exception:
                pass
        return 0.0

    def save_config(self):
        try:
            with open(self.config_file, "w") as f:
                json.dump({"offset": self.offset}, f)
        except Exception:
            pass

    def get_key_nonblocking(self):
        if select.select([sys.stdin], [], [], 0)[0]:
            return sys.stdin.read(1)
        return None

    def get_nowplaying_info(self):
        now = time.time()
        if now - self.last_media_check < 0.25 and self.cached_media:
            return self.cached_media

        self.last_media_check = now
        try:
            res = subprocess.run(
                ["nowplaying-cli", "get", "title", "artist", "elapsedTime", "playbackRate"],
                capture_output=True, text=True, timeout=0.8
            )
            raw = res.stdout.strip()
            if not raw: return None
                
            lines = [line.strip() for line in raw.splitlines() if line.strip()]
            if len(lines) >= 1:
                title = lines[0] if lines[0] != "null" else ""
                artist = lines[1] if len(lines) > 1 and lines[1] != "null" else ""
                
                try:
                    elapsed = float(lines[2]) if len(lines) > 2 and lines[2] != "null" else 0.0
                except ValueError:
                    elapsed = 0.0
                    
                try:
                    rate = float(lines[3]) if len(lines) > 3 and lines[3] != "null" else 1.0
                except ValueError:
                    rate = 1.0

                if title:
                    self.cached_media = {
                        "title": title, 
                        "artist": artist, 
                        "elapsed": elapsed,
                        "rate": rate
                    }
                    return self.cached_media
        except Exception:
            pass
        return None

    def clean_string(self, text):
        if not text: return ""
        text = re.sub(r'\(.*?\)|\[.*?\]', '', text)
        text = re.sub(r'(?i)\b(feat|ft|official|lyric|video|audio|remastered|remaster)\b.*', '', text)
        return text.strip()

    def check_local_lyrics(self, track, artist):
        patterns = [
            f"{artist} - {track}.lrc",
            f"{track} - {artist}.lrc",
            f"{track}.lrc"
        ]
        for p in patterns:
            file_path = os.path.join(self.local_lyrics_dir, p)
            if os.path.exists(file_path):
                try:
                    with open(file_path, "r", encoding="utf-8") as f:
                        print(f"📁 Loaded local lyrics from ~/Lyrics/{p}\n")
                        return self.parse_lrc(f.read())
                except Exception:
                    pass
        return None

    def fetch_lyrics(self, track, artist):
        local_parsed = self.check_local_lyrics(track, artist)
        if local_parsed: return local_parsed

        safe_title = re.sub(r'[^\w\-_\. ]', '_', f"{artist}_{track}".lower())
        cache_file = os.path.join(self.cache_dir, f"{safe_title}.json")
        
        if os.path.exists(cache_file):
            try:
                with open(cache_file, "r", encoding="utf-8") as f:
                    print("⚡ Loaded synced lyrics from local cache!\n")
                    return json.load(f)
            except Exception:
                pass

        c_track, c_artist = self.clean_string(track), self.clean_string(artist)
        print(f"🔍 Searching LRCLib for: '{c_track}' by '{c_artist}'...")
        synced_raw = None

        endpoints = [
            ("https://lrclib.net/api/get", {"track_name": c_track, "artist_name": c_artist}),
            ("https://lrclib.net/api/search", {"q": f"{c_track} {c_artist}".strip()}),
            ("https://lrclib.net/api/search", {"q": c_track})
        ]

        for url, params in endpoints:
            try:
                res = requests.get(url, headers=self.headers, params=params, timeout=3)
                if res.status_code == 200:
                    data = res.json()
                    if isinstance(data, list):
                        for item in data:
                            if item.get("syncedLyrics"):
                                synced_raw = item["syncedLyrics"]
                                break
                    elif data.get("syncedLyrics"):
                        synced_raw = data["syncedLyrics"]
                    
                    if synced_raw:
                        print("✓ Lyrics found!\n")
                        break
            except Exception:
                continue

        if synced_raw:
            parsed = self.parse_lrc(synced_raw)
            try:
                with open(cache_file, "w", encoding="utf-8") as f:
                    json.dump(parsed, f)
            except Exception:
                pass
            return parsed
        return None

    def parse_lrc(self, lrc_text):
        pattern = re.compile(r'\[(\d{2}):(\d{2})\.(\d{2,3})\](.*)')
        lyrics = []
        for line in lrc_text.splitlines():
            match = pattern.match(line)
            if match:
                m, s, ms = int(match.group(1)), int(match.group(2)), int(match.group(3))
                if len(match.group(3)) == 2: ms *= 10
                time_sec = m * 60 + s + ms / 1000.0
                text = match.group(4).strip()
                if text:
                    lyrics.append({"time": time_sec, "text": text})
        lyrics.sort(key=lambda x: x["time"])
        return lyrics

    def render_header(self, title="", artist=""):
        os.system('clear')
        term_width = os.get_terminal_size().columns
        print("═" * term_width)
        print("🎤 REAL-TIME KARAOKE PLAYER".center(term_width))
        if title:
            print(f"🎵 Track: {title} — {artist or 'Unknown'}".center(term_width))
        
        o_sign = "+" if self.offset >= 0 else ""
        print(f"Presets: [1] Wired (0.0s) | [2] Bluetooth (+0.3s) | [3] AirPlay (+2.0s)".center(term_width))
        print(f"Controls: [Q] Quit | [O] Open Track | [+/-] Step 0.1s | Offset: {o_sign}{self.offset:.1f}s".center(term_width))
        print("═" * term_width + "\n")

    def format_running_color(self, line_text, linear_ratio):
        num_chars = len(line_text)
        if num_chars == 0: return "", ""
        sung_count = int(num_chars * max(0.0, min(1.0, linear_ratio)))
        
        sung_str = line_text[:sung_count]
        unsung_str = line_text[sung_count:]
        
        top_line = f"{VT_DOUBLE_TOP}\033[1;33m{sung_str}\033[0;37m{unsung_str}\033[0m{CLR_LINE}"
        bot_line = f"{VT_DOUBLE_BOT}\033[1;33m{sung_str}\033[0;37m{unsung_str}\033[0m{CLR_LINE}"
        return top_line, bot_line

    def run(self):
        self.render_header()
        print("Listening for macOS media playback...\n")

        old_settings = termios.tcgetattr(sys.stdin)
        try:
            tty.setcbreak(sys.stdin.fileno())

            while True:
                key = self.get_key_nonblocking()
                if key:
                    k = key.lower()
                    if k == 'q': break
                    elif k == '1':
                        self.offset = 0.0
                        self.save_config()
                        self.render_header(self.current_title, self.current_artist)
                        self.last_active_index = -2
                    elif k == '2':
                        self.offset = 0.3
                        self.save_config()
                        self.render_header(self.current_title, self.current_artist)
                        self.last_active_index = -2
                    elif k == '3':
                        self.offset = 2.0
                        self.save_config()
                        self.render_header(self.current_title, self.current_artist)
                        self.last_active_index = -2
                    elif key in ('+', '='):
                        self.offset += 0.1
                        self.save_config()
                        self.render_header(self.current_title, self.current_artist)
                        self.last_active_index = -2
                    elif key in ('-', '_'):
                        self.offset -= 0.1
                        self.save_config()
                        self.render_header(self.current_title, self.current_artist)

                now = time.time()
                media = self.get_nowplaying_info()

                if media:
                    new_track = f"{media['title']} - {media['artist']}"
                    if new_track != self.current_track_id:
                        self.current_track_id = new_track
                        self.current_title = media['title']
                        self.current_artist = media['artist']
                        self.render_header(self.current_title, self.current_artist)
                        self.lyrics = self.fetch_lyrics(self.current_title, self.current_artist)
                        
                        self.last_active_index = -2
                        self.start_wall_time = now
                        self.base_audio_time = media['elapsed']
                        self.was_paused = False

                        if not self.lyrics:
                            print("❌ No synced lyrics (.lrc) found locally or on LRCLib.")
                        else:
                            print("--- 🎶 KARAOKE LIVE RUNNING --- \n")

                if self.lyrics:
                    rep_elap = media['elapsed'] if media else 0.0
                    rate = media['rate'] if media else 1.0
                    
                    if rate > 0:
                        if self.was_paused:
                            # Just resumed: Force re-anchor immediately to incoming audio position
                            self.start_wall_time = now
                            self.base_audio_time = rep_elap
                            self.was_paused = False

                        calc_time = self.base_audio_time + (now - self.start_wall_time)
                        
                        # Handle manual scrubbing/skipping shifts
                        if abs(calc_time - rep_elap) > 0.3 and rep_elap > 0:
                            self.start_wall_time = now
                            self.base_audio_time = rep_elap
                            calc_time = rep_elap
                    else:
                        # Paused state: Lock calculation timeline entirely
                        calc_time = rep_elap
                        self.start_wall_time = now
                        self.base_audio_time = rep_elap
                        self.was_paused = True

                    audio_time = calc_time + self.offset
                    
                    active_index = -1
                    for i, line in enumerate(self.lyrics):
                        if audio_time >= line["time"]:
                            active_index = i
                        else:
                            break

                    if active_index != -1:
                        curr_line_time = self.lyrics[active_index]["time"]
                        
                        if active_index + 1 < len(self.lyrics):
                            next_line_time = self.lyrics[active_index + 1]["time"]
                            duration = max(0.5, next_line_time - curr_line_time)
                        else:
                            duration = 4.0
                            
                        elapsed_in_line = audio_time - curr_line_time
                        progress_ratio = max(0.0, min(1.0, elapsed_in_line / duration))

                        curr_text = self.lyrics[active_index]["text"]
                        top_line, bot_line = self.format_running_color(curr_text, progress_ratio)

                        if active_index != self.last_active_index:
                            if self.last_active_index >= 0:
                                prev_text = self.lyrics[self.last_active_index]["text"]
                                sys.stdout.write(f"\033[2F\033[0G\033[32m✔ {prev_text}\033[0m{CLR_LINE}\n{CLR_LINE}\n")
                            
                            sys.stdout.write(f"{top_line}\n{bot_line}\n")
                            sys.stdout.flush()
                            self.last_active_index = active_index
                        else:
                            sys.stdout.write(f"\033[2F\033[0G{top_line}\n{bot_line}\n")
                            sys.stdout.flush()

                time.sleep(0.03)

        except KeyboardInterrupt:
            pass
        finally:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
            print("\n\nStopped Karaoke session cleanly.")

if __name__ == "__main__":
    KaraokeApp().run()
EOF

python3 "$TEMP_PY"
rm -f "$TEMP_PY"
